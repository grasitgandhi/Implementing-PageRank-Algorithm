# Python bytecode caches -- regenerated on every run, never useful in a diff
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Local virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Crawled page store -- regenerated by `python cli.py crawl`, and large.
# NOTE: edges.txt is deliberately NOT ignored. It is committed as the demo
# fallback so ranking and search still run if the internet is down during
# evaluation (SRS NFR4).
pages.db
demo_pages.db
benchmark_pages.db
*.sqlite
*.sqlite3

# Node / Frontend dependencies & build artifacts
node_modules/
frontend/node_modules/
dist/
dist-ssr/
frontend/dist/
build/
*.tsbuildinfo

# Frontend env and cache files
.env.local
.env.*.local
.eslintcache
.parcel-cache/

# Logs & temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tmp
*.temp

# Editor / OS noise
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
.DS_Store
Thumbs.db
desktop.ini
