# Python bytecode caches -- regenerated on every run, never useful in a diff
__pycache__/
*.py[cod]
*$py.class

# Local virtual environments (none is required for this project, but people
# sometimes make one anyway)
venv/
.venv/
env/
ENV/

# Python test & coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Node / Frontend dependencies & build artifacts
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
*.tsbuildinfo
.vite/

# Logs & debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and local secret files
.env
.env.*
!.env.example
*.local

# Runtime data & search history bridge file
searches.json

# Crawled page store -- regenerated by `python cli.py crawl`, and large.
# NOTE: edges.txt is deliberately NOT ignored. It is committed as the demo
# fallback so ranking and search still run if the internet is down during
# evaluation (SRS NFR4).
pages.db
demo_pages.db
benchmark_pages.db
*.sqlite
*.sqlite3

# Editor / IDE / OS noise
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
