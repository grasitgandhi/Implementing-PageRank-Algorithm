# Python bytecode caches -- regenerated on every run, never useful in a diff
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Local virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Crawled page store and runtime logs
# NOTE: edges.txt is deliberately NOT ignored. It is committed as the demo
# fallback so ranking and search still run if the internet is down during
# evaluation (SRS NFR4).
pages.db
demo_pages.db
benchmark_pages.db
searches.db
crawls.db
searches.json
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Node / Frontend dependencies & build artifacts
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
build/
*.tsbuildinfo
.vite/
frontend/.vite/

# Frontend environment and cache files
.env
.env.*
!.env.example
*.local
.eslintcache
.parcel-cache/

# Logs & temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tmp
*.temp

# Editor / IDE / OS noise
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
Desktop.ini
