# Python bytecode caches -- regenerated on every run, never useful in a diff
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Local virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python test & coverage artifacts
.pytest_cache/
.coverage
htmlcov/
.tox/

# Node / Frontend dependencies & build artifacts
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
frontend/dist/
build/
*.tsbuildinfo
.vite/

# Logs & debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tmp
*.temp

# Environment and local secret files
.env
.env.*
!.env.example
*.local
.env.local
.eslintcache
.parcel-cache/

# Runtime data & search history bridge file
searches.json

# Crawled page store -- regenerated by `python cli.py crawl`, and large.
# NOTE: edges.txt is deliberately NOT ignored. It is committed as the demo
# fallback so ranking and search still run if the internet is down during
# evaluation (SRS NFR4).
pages.db
demo_pages.db
benchmark_pages.db
*.sqlite
*.sqlite3

# Editor / IDE / OS noise
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
.DS_Store
Thumbs.db
Desktop.ini
desktop.ini
*.swp
*.swo
